{
  "name": "focus-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Focus, integrated into Discord Desktop. The former WebView2 prototype is archived.",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm build && pnpm desktop:install",
    "dev:legacy": "vite --host 127.0.0.1",
    "build": "node scripts/build-desktop.mjs",
    "build:legacy": "tsc --noEmit && node scripts/build-bridge.mjs && vite build",
    "test:desktop": "node scripts/test-desktop.mjs",
    "audit:settings": "node scripts/audit-desktop-settings.mjs",
    "test:patches": "node scripts/check-desktop-patches.mjs",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1",
    "desktop:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1 -Uninstall",
    "lint": "eslint src tests scripts desktop/plugin --max-warnings 0",
    "test": "vitest run",
    "test:ui": "node scripts/test-ui.mjs",
    "tauri": "node scripts/tauri.mjs",
    "benchmark": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark.ps1",
    "check": "pnpm lint && pnpm test && pnpm test:desktop && pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.58.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
